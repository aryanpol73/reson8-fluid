# Jamendo API Configuration
# Register an application at https://devportal.jamendo.com to obtain a Client ID.
# Note: JAMENDO_CLIENT_SECRET is NEVER required for public track search and audio streaming.
# Never expose secrets in client bundles.
VITE_JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Audius API Configuration (Optional)
# Audius public read endpoints (trending/search/stream) function out-of-the-box.
# An optional API key can be created at https://audius.co/settings for higher rate limits.
# Never use or expose a bearer token in frontend code.
VITE_AUDIUS_API_KEY=
